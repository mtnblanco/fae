# ─────────────────────────────────────────────────────────────
# Copiá este archivo como .env.local y completá los valores.
# En Vercel, cargá las mismas variables en Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública: la "publishable key" (sb_publishable_...) o la "anon key" legacy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Clave secreta: la "secret key" (sb_secret_...) o la "service_role key" legacy.
# ⚠️ NUNCA la compartas ni la pongas con prefijo NEXT_PUBLIC_. Solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# URL pública de la app (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: dominio de los emails internos que se generan a partir del teléfono.
# Si lo cambiás con clientes ya creados, esos clientes no van a poder entrar.
# CLIENTES_EMAIL_DOMAIN=clientes.local

# Opcional: notificaciones push de turnos para los barberos (Web Push con VAPID).
# Generalas UNA sola vez con:  npx web-push generate-vapid-keys
# Sin estas claves la app funciona igual; solo que no manda avisos.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=la-public-key
# VAPID_PRIVATE_KEY=la-private-key
# VAPID_SUBJECT=mailto:tu-email@ejemplo.com
